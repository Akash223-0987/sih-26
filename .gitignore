# ==============================================================================
# PyTrace .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / Packaging / Builds
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Logs & Pipeline Telemetry Outputs
logs/
*.log
*.log.*
log-data/
temp_logs/

# Fluent Bit & Collector State
*.pos
*.pos.old
*.db
fluent-bit.pos
flb-storage/
flb-state/

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Unit Test, Coverage, and Type Checking
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
cover/
.tox/
.nox/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IDEs & Editor Configuration
.idea/
.vscode/
*.swp
*.swo
*~
*.bak

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Temporary data / Scratch files
scratch/
tmp/