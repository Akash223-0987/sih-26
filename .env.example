# ==============================================================================
# PyTrace / ULPF Security Platform - Notification Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Gmail SMTP Settings (Outbound Security Alert Emails)
# ------------------------------------------------------------------------------
# Sender Gmail address
SMTP_USER=your-email@gmail.com

# 16-character Gmail App Password (generated at myaccount.google.com/security)
SMTP_PASSWORD=abcd efgh ijkl mnop

# Target SecOps email address to receive threat alerts
RECIPIENT_EMAIL=secops-admin@yourdomain.com

# SMTP Server details (default: smtp.gmail.com:587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ------------------------------------------------------------------------------
# HTTP Webhook Settings (Raw JSON Alert Dispatcher)
# ------------------------------------------------------------------------------
# URL of internal dashboard, Slack, Discord, or ULPF notification service
NOTIFICATION_WEBHOOK_URL=http://localhost:8080/v1/alerts

# ------------------------------------------------------------------------------
# Alert Storage & History Limits
# ------------------------------------------------------------------------------
ALERT_HISTORY_SIZE=200
